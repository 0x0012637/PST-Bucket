  "persist": "config",
  "pre_install": [ "@'", "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\" ?>", "<FileZilla3>", "  <Settings>", "    <Setting name=\"Config Location\">config</Setting>", "    <Setting name=\"Disable update check\">1</Setting>", "  </Settings>", "</FileZilla3>", "'@ | Out-File \"$dir\\fzdefaults.xml\" -Encoding Ascii", "", "$oldfzdefault = \"$persist_dir\\fzdefaults.xml\"", "if (Test-Path \"$oldfzdefault\") {", "    Write-Host 'Adopting new persist configuration...' -f Yellow", "    $oldConfigDir = \"$((Get-Item \"$persist_dir\").PSDrive.Root)filezilla\"", "    $newConfigDir = \"$persist_dir\\config\"", "    if (Test-Path \"$oldConfigDir\") {", "        Write-Host \"Moving existing configuration from '$oldConfigDir' to '$newConfigDir'\" -f Yellow", "        if (Test-Path \"$newConfigDir\") {", "            Move-Item \"$oldConfigDir\\*\" \"$newConfigDir\"", "        } else { ", "            Move-Item \"$oldConfigDir\" \"$newConfigDir\"", "        }", "    }", "    Rename-Item \"$oldfzdefault\" \"fzdefaults.xml.bak\"", "}" ],
