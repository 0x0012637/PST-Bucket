{
  "autoupdate": {
    "hash": {
      "regex": "(?sm)$basename.*?SHA-256: $sha256",
      "url": "https://winscp.net/download/WinSCP-$version-ReadMe.txt"
    },
    "url": "https://downloads.sourceforge.net/project/winscp/WinSCP/$version/WinSCP-$version-Portable.zip"
  },
  "bin": [ "WinSCP.exe", [ "WinSCP.com", "WinSCP-cli" ] ],
  "checkver": {
    "regex": "WinSCP-([\\d.]+)-Portable\\.zip",
    "url": "https://winscp.net/eng/downloads.php"
  },
  "description": "Copy files between a local computer and remote servers using FTP, FTPS, SCP, SFTP, WebDAV or S3 file transfer protocols.",
  "hash": "bf1e3fa79d2d2567a7a47a5a34a683c61f6d8502e86dd8fe6394c1f33cad76eb",
  "homepage": "https://winscp.net",
  "license": "GPL-3.0-or-later",
  "persist": "winscp.ini",
  "post_install": [ "Invoke-WebRequest -URI \"https://winscp.net/translations/dll/$version/chs.zip\" -OutFile \"$dir\\chs.zip\"", "7z x \"$dir\\chs.zip\" -o\"$dir\\\"" ],
  "pre_install": [ "if (!(Test-Path \"$persist_dir\\winscp.ini\")) {", "    @(", "        '[Configuration\\Interface]'", "        'RandomSeedFile=.\\winscp.rnd'", "    ) | Add-Content -Path \"$dir\\winscp.ini\" -Encoding ASCII -Force", "}" ],
  "url": "https://downloads.sourceforge.net/project/winscp/WinSCP/6.3.2/WinSCP-6.3.2-Portable.zip",
  "version": "6.3.2"
}